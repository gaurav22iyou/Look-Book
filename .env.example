# ===================================================================
# BookNow - Workspace Environment Variables Template
# NEVER commit real .env files with credentials to version control.
# ===================================================================

# Active Spring Profile (local or prod)
SPRING_PROFILES_ACTIVE=local

# Local Database Settings (PostgreSQL)
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5432
LOCAL_DB_NAME=booknow_db
LOCAL_DB_USERNAME=postgres
LOCAL_DB_PASSWORD=your_local_postgres_password
LOCAL_DB_URL=jdbc:postgresql://localhost:5432/booknow_db

# Production Database Settings (Render PostgreSQL)
DB_URL=jdbc:postgresql://<render-db-host>:5432/<render-db-name>
DB_USERNAME=<render-db-username>
DB_PASSWORD=<render-db-password>

# Server Port
PORT=8080

# CORS Allowed Origins
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
