# ===================================================================
# BookNow - Backend Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!
# ===================================================================

# Profile to activate: 'local' for local development, 'prod' for Render deployment
SPRING_PROFILES_ACTIVE=local

# -------------------------------------------------------------------
# Local Profile Settings (used when SPRING_PROFILES_ACTIVE=local)
# -------------------------------------------------------------------
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5432
LOCAL_DB_NAME=booknow_db
LOCAL_DB_USERNAME=postgres
LOCAL_DB_PASSWORD=your_local_postgres_password
# Alternatively specify full JDBC URL:
LOCAL_DB_URL=jdbc:postgresql://localhost:5432/booknow_db

# -------------------------------------------------------------------
# Production Profile Settings (used when SPRING_PROFILES_ACTIVE=prod on Render)
# -------------------------------------------------------------------
# Option A: Standard JDBC URL with separate user/password (Recommended)
# DB_URL=jdbc:postgresql://dpg-xxxxxx-a.oregon-postgres.render.com:5432/booknow_db
# DB_USERNAME=booknow_db_user
# DB_PASSWORD=your_render_db_password

# Option B: Render Internal/External PostgreSQL Connection URL
# Note: Automatically converted to jdbc:postgresql:// by DatabaseUrlEnvironmentPostProcessor
# DB_URL=postgresql://user:password@dpg-xxxxxx-a:5432/booknow_db

# -------------------------------------------------------------------
# Common Settings
# -------------------------------------------------------------------
PORT=8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://look-book-frontend-eopf.onrender.com

# Default Seed User Passwords (for initial development seed)
USER1_PASSWORD=user1pass
USER2_PASSWORD=user2pass
ADMIN_PASSWORD=adminpass
